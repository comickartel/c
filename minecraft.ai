<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BlockMind AI</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #111827;
      color: white;
      min-height: 100vh;
    }

    /* =========================
       NAVIGATION BAR
    ========================= */

    .navbar {
      height: 70px;
      width: 100%;
      background: #182235;
      border-bottom: 1px solid #2d3a50;

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 30px;

      position: fixed;
      top: 0;
      left: 0;
      z-index: 1000;
    }

    /* Logo */

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;

      font-size: 22px;
      font-weight: bold;
      color: #55ff55;

      text-decoration: none;
    }

    .logo-icon {
      width: 38px;
      height: 38px;

      background: #55aa55;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 8px;

      box-shadow: 0 0 15px rgba(85,255,85,0.3);
    }

    /* Navigation links */

    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;

      list-style: none;
    }

    .nav-links a {
      color: #cbd5e1;
      text-decoration: none;

      padding: 10px 14px;

      border-radius: 8px;

      transition: 0.2s;
    }

    .nav-links a:hover {
      color: white;
      background: #26354d;
    }

    .nav-links a.active {
      color: #55ff55;
      background: #203a29;
    }

    /* AI button */

    .ask-button {
      background: #55aa55;
      color: white;

      border: none;

      padding: 11px 18px;

      border-radius: 8px;

      font-weight: bold;

      cursor: pointer;

      transition: 0.2s;
    }

    .ask-button:hover {
      background: #66cc66;
      transform: translateY(-2px);

      box-shadow: 0 5px 20px rgba(85,255,85,0.25);
    }

    /* Mobile menu button */

    .menu-button {
      display: none;

      background: none;
      border: none;

      color: white;
      font-size: 28px;

      cursor: pointer;
    }

    /* =========================
       MAIN CONTENT
    ========================= */

    main {
      padding-top: 110px;

      max-width: 1100px;
      margin: auto;

      padding-left: 25px;
      padding-right: 25px;
    }

    .hero {
      text-align: center;

      padding: 80px 20px;
    }

    .hero h1 {
      font-size: 50px;
      margin-bottom: 15px;
    }

    .green {
      color: #55ff55;
    }

    .hero p {
      color: #9ca3af;
      font-size: 18px;
    }

    /* AI search box */

    .ai-box {
      max-width: 750px;
      margin: 30px auto;

      background: #182235;

      border: 1px solid #2d3a50;

      padding: 10px;

      border-radius: 14px;

      display: flex;
      gap: 10px;
    }

    .ai-box input {
      flex: 1;

      background: transparent;

      border: none;
      outline: none;

      color: white;

      font-size: 16px;

      padding: 12px;
    }

    .ai-box input::placeholder {
      color: #64748b;
    }

    .ai-box button {
      background: #55aa55;

      color: white;

      border: none;

      padding: 12px 20px;

      border-radius: 9px;

      cursor: pointer;

      font-weight: bold;
    }

    /* Cards */

    .cards {
      display: grid;

      grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));

      gap: 20px;

      margin-top: 40px;
    }

    .card {
      background: #182235;

      border: 1px solid #2d3a50;

      padding: 25px;

      border-radius: 14px;

      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-5px);

      border-color: #55aa55;

      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .card h3 {
      margin-bottom: 10px;
    }

    .card p {
      color: #94a3b8;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 800px) {

      .navbar {
        padding: 0 18px;
      }

      .menu-button {
        display: block;
      }

      .nav-links {
        display: none;

        position: absolute;

        top: 70px;
        left: 0;

        width: 100%;

        background: #182235;

        flex-direction: column;

        padding: 15px;
      }

      .nav-links.show {
        display: flex;
      }

      .nav-links a {
        width: 100%;
        text-align: center;
      }

      .ask-button {
        display: none;
      }

      .hero h1 {
        font-size: 36px;
      }
    }
  </style>
</head>

<body>

  <!-- =========================
       NAVBAR
  ========================= -->

  <nav class="navbar">

    <a href="#" class="logo">
      <span class="logo-icon">⛏️</span>
      BlockMind AI
    </a>

    <ul class="nav-links" id="navLinks">

      <li>
        <a href="#" class="active">
          Home
        </a>
      </li>

      <li>
        <a href="#ask">
          Ask AI
        </a>
      </li>

      <li>
        <a href="#guides">
          Guides
        </a>
      </li>

      <li>
        <a href="#items">
          Items
        </a>
      </li>

      <li>
        <a href="#mobs">
          Mobs
        </a>
      </li>

      <li>
        <a href="#settings">
          Settings
        </a>
      </li>

    </ul>

    <button class="ask-button" onclick="focusAI()">
      Ask AI
    </button>

    <button
      class="menu-button"
      onclick="toggleMenu()"
      aria-label="Open menu"
    >
      ☰
    </button>

  </nav>


  <!-- =========================
       PAGE
  ========================= -->

  <main>

    <section class="hero">

      <h1>
        Your <span class="green">Minecraft AI</span>
      </h1>

      <p>
        Ask anything about Minecraft.
        Get instant answers.
      </p>

      <div class="ai-box" id="ask">

        <input
          id="question"
          type="text"
          placeholder="Ask something like: How do I make a Nether portal?"
        >

        <button onclick="askAI()">
          Ask
        </button>

      </div>

      <div id="answer"></div>

    </section>


    <!-- FEATURES -->

    <section class="cards" id="guides">

      <div class="card">
        <h3>📖 Minecraft Guides</h3>

        <p>
          Learn how to build farms, defeat bosses,
          find structures and survive.
        </p>
      </div>


      <div class="card" id="items">

        <h3>🧱 Items</h3>

        <p>
          Search Minecraft items and learn their
          recipes, uses and locations.
        </p>
      </div>


      <div class="card" id="mobs">

        <h3>🐷 Mobs</h3>

        <p>
          Learn about mobs, drops, behavior,
          spawning and weaknesses.
        </p>
      </div>


      <div class="card">

        <h3>⚔️ Combat</h3>

        <p>
          Get tips for fighting the Ender Dragon,
          Wither and hostile mobs.
        </p>
      </div>

    </section>

  </main>


  <!-- =========================
       JAVASCRIPT
  ========================= -->

  <script>

    function toggleMenu() {

      const menu = document.getElementById("navLinks");

      menu.classList.toggle("show");

    }


    function focusAI() {

      document
        .getElementById("question")
        .focus();

      document
        .getElementById("ask")
        .scrollIntoView({
          behavior: "smooth"
        });

    }


    function askAI() {

      const question =
        document.getElementById("question").value;

      const answer =
        document.getElementById("answer");

      if (question.trim() === "") {

        answer.innerHTML =
          "<p style='color:#ff5555'>Please enter a question.</p>";

        return;

      }

      /*
        THIS IS WHERE YOUR REAL AI API
        WILL EVENTUALLY GO.
      */

      answer.innerHTML = `
        <div style="
          background:#182235;
          border:1px solid #2d3a50;
          padding:20px;
          border-radius:12px;
          margin-top:20px;
        ">

          <strong>You asked:</strong>

          <p style="margin-top:10px;color:#cbd5e1;">
            ${question}
          </p>

          <p style="
            margin-top:15px;
            color:#55ff55;
          ">
            🤖 AI response will appear here!
          </p>

        </div>
      `;

    }


    document
      .getElementById("question")
      .addEventListener("keydown", function(event) {

        if (event.key === "Enter") {

          askAI();

        }

      });

  </script>

</body>
</html>
